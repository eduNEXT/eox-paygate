# Requirements for test runs.
-c constraints.txt

-r base.in               # Core dependencies for this package

pytest-cov               # pytest extension for code coverage statistics
pytest-django            # pytest extension for better Django support

# Runtime dependencies of openedx-zeitlabs-payments that it does not declare, and edx-opaque-keys for its
# edx-platform mocks. openedx-zeitlabs-payments itself is installed from its main branch (see the Makefile).
babel
djangorestframework
edx-django-utils
edx-opaque-keys[django]
edx-toggles
